{
  "name": "@botpanel/server",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:e2e": "BOTPANEL_E2E=1 vitest run tests/e2e.docker.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.3.0",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.4",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/node": "^22.20.2",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
