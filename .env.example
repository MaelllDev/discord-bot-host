# ==============================================================================
# BotPanel — environment file
#
# Copy this file and edit the values:
#
#   sudo cp .env.example /etc/botpanel.env
#   sudo nano /etc/botpanel.env
#
# The systemd service reads it through `EnvironmentFile=-/etc/botpanel.env`,
# so no value here is baked into the build. Only BOTPANEL_PASSWORD is required;
# everything else has a sensible default.
#
# Secret values live ONLY in this file (not in the repository, not in the panel
# UI). AI provider keys are the exception: they are typed in the panel and kept
# in the SQLite database.
# ==============================================================================

# --- Access -------------------------------------------------------------------

# Password required to open the panel. REQUIRED in practice: when it is empty
# the panel generates a random one on first boot and writes it to the log
# (`journalctl -u botpanel`) and to <DATA_DIR>/.initial-password.
# Example: BOTPANEL_PASSWORD=a-long-password-you-can-remember
BOTPANEL_PASSWORD=change-me

# Alternative to the plain password: scrypt hash. When both are set, the hash
# wins. Format: scrypt$<salt>$<hash> (see docs/configuration.md for how to
# generate one).
# BOTPANEL_PASSWORD_HASH=

# Secret used to sign the session cookie (HMAC-SHA256). Leave empty and the
# panel generates one and stores it in <DATA_DIR>/.session-secret (kept across
# restarts). Set it explicitly only when you want the cookie to survive moving
# the data directory elsewhere. Minimum 16 characters.
# BOTPANEL_SECRET=

# How long a login session stays valid, in hours. Default: 168 (7 days).
BOTPANEL_SESSION_TTL_HOURS=168

# Name shown in the sidebar and in page titles. Default: BotPanel.
BOTPANEL_NAME=BotPanel

# --- Network ------------------------------------------------------------------

# Interface to listen on. 0.0.0.0 exposes it on every interface; use 127.0.0.1
# when a reverse proxy on the same VPS is the only thing that should reach it.
# Default: 0.0.0.0
BOTPANEL_HOST=0.0.0.0

# HTTP port. Default: 8080
BOTPANEL_PORT=8080

# Set to 1 only when the panel is reached through HTTPS (reverse proxy). It
# marks the session cookie as `Secure`, so it is never sent over plain HTTP.
# Default: 0
BOTPANEL_COOKIE_SECURE=0

# Set to 1 only when a reverse proxy is in front of the panel. Makes rate
# limiting and logging use X-Forwarded-For. Default: 0
BOTPANEL_TRUST_PROXY=0

# --- Storage ------------------------------------------------------------------

# Where the database, the releases and the persistent /data volumes live.
# Default: /var/lib/botpanel
BOTPANEL_DATA_DIR=/var/lib/botpanel

# Docker daemon socket. Default: /var/run/docker.sock
BOTPANEL_DOCKER_SOCKET=/var/run/docker.sock

# Maximum accepted ZIP upload size, in MB. Default: 512
BOTPANEL_MAX_UPLOAD_MB=512

# How many releases to keep per application (0 = keep all). When the limit is
# reached, the oldest releases are deleted after a successful deploy.
# Default: 10
BOTPANEL_KEEP_RELEASES=10

# --- Containers ---------------------------------------------------------------

# UID/GID used inside the containers and owner of the application files on the
# host. Default: 1000
BOTPANEL_RUN_UID=1000
BOTPANEL_RUN_GID=1000

# Comma-separated list of Docker images the panel is allowed to use. Empty or
# unset means "any image". Example:
# BOTPANEL_ALLOWED_IMAGES=node:22-slim,python:3.12-slim
# BOTPANEL_ALLOWED_IMAGES=

# --- Development only ---------------------------------------------------------

# Set to 1 to stop serving the built frontend (use it when running the Vite dev
# server on port 5173 instead). Never set it in production.
# BOTPANEL_DISABLE_STATIC=1
